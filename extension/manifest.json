{
  "manifest_version": 3,
  "name": "Slop 911",
  "version": "0.1.0",
  "description": "On-demand AI-writing score for X and LinkedIn posts via a Cloudflare Worker + TypeSafe Jev.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/shared.js", "content/x.js"],
      "css": ["styles/button.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["content/shared.js", "content/linkedin.js"],
      "css": ["styles/button.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Slop 911",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
