{
  "name": "@tweet-911/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Tweet 911 Chrome MV3 extension (WXT + React)",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
